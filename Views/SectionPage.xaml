<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.SectionPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:FlatOut4SaveEditor.Models"
    xmlns:views="using:FlatOut4SaveEditor.Views"
    xmlns:vm="using:FlatOut4SaveEditor.ViewModels"
    NavigationCacheMode="Disabled">

    <Page.Resources>
        <!--  Block header: title, description and the block's buttons.  -->
        <DataTemplate x:Key="BlockActionTemplate" x:DataType="vm:BlockAction">
            <Button Command="{x:Bind Command}" ToolTipService.ToolTip="{x:Bind views:Ui.Tip(Tooltip)}">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="{x:Bind Glyph}" />
                    <TextBlock Text="{x:Bind Label}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SettingCardTemplate" x:DataType="m:SaveFieldViewModel">
            <Grid
                MinHeight="68"
                Padding="16,10,16,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="24"
                CornerRadius="{StaticResource ControlCornerRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Grid.ColumnSpan="2"
                    Margin="-16,-10,-16,-10"
                    Background="{x:Bind views:Ui.HighlightBrush(IsHighlighted), Mode=OneWay}"
                    CornerRadius="{StaticResource ControlCornerRadius}"
                    IsHitTestVisible="False" />
                <StackPanel VerticalAlignment="Center" Spacing="2">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="{x:Bind Label}" TextWrapping="Wrap" />
                        <Ellipse
                            Width="7"
                            Height="7"
                            VerticalAlignment="Center"
                            Fill="{ThemeResource AccentFillColorDefaultBrush}"
                            ToolTipService.ToolTip="Changed since the file was opened"
                            Visibility="{x:Bind IsModified, Mode=OneWay}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="{x:Bind Description}"
                        Visibility="{x:Bind HasDescription}" />
                    <TextBlock
                        Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Error, Mode=OneWay}"
                        TextWrapping="Wrap"
                        Visibility="{x:Bind HasError, Mode=OneWay}" />
                </StackPanel>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="6">
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Revert"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRevertFieldClicked"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Put back the value from the file"
                        Visibility="{x:Bind IsModified, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                    </Button>
                    <ContentControl
                        HorizontalContentAlignment="Right"
                        VerticalAlignment="Center"
                        Content="{x:Bind}"
                        ContentTemplateSelector="{StaticResource CardEditorSelector}"
                        IsTabStop="False"
                        ToolTipService.ToolTip="{x:Bind ToolTipText}" />
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="FieldGroupTemplate" x:DataType="vm:FieldGroupBlock">
            <StackPanel MaxWidth="1080" HorizontalAlignment="Stretch" Spacing="4">
                <Grid Margin="2,0,0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Spacing="2">
                        <TextBlock Style="{StaticResource BlockTitleStyle}" Text="{x:Bind Title}" />
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="{x:Bind Description}"
                            Visibility="{x:Bind HasDescription}" />
                    </StackPanel>
                    <ItemsRepeater
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        ItemTemplate="{StaticResource BlockActionTemplate}"
                        ItemsSource="{x:Bind Actions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
                <ItemsRepeater
                    x:Name="Items"
                    ItemTemplate="{StaticResource SettingCardTemplate}"
                    ItemsSource="{x:Bind Fields}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="4" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate" x:DataType="vm:NoteBlock">
            <InfoBar
                MaxWidth="1080"
                HorizontalAlignment="Stretch"
                IsClosable="False"
                IsOpen="True"
                Message="{x:Bind Message, Mode=OneWay}"
                Severity="{x:Bind views:Ui.Severity(Severity), Mode=OneWay}"
                Title="{x:Bind Title}" />
        </DataTemplate>

        <DataTemplate x:Key="TrophyCardTemplate" x:DataType="m:SaveFieldViewModel">
            <Grid
                Padding="14,12"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="40"
                    Height="40"
                    VerticalAlignment="Top"
                    Background="{x:Bind views:Ui.HighlightBrush(IsHighlighted), Mode=OneWay}"
                    CornerRadius="20">
                    <!--  One icon per state, so both colours are ThemeResources that follow the window's theme.  -->
                    <FontIcon
                        FontSize="22"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE735;"
                        Visibility="{x:Bind views:Ui.Collapsed(BoolValue), Mode=OneWay}" />
                    <FontIcon
                        FontSize="22"
                        Foreground="{ThemeResource AccentFillColorDefaultBrush}"
                        Glyph="&#xE735;"
                        Visibility="{x:Bind BoolValue, Mode=OneWay}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="2">
                    <TextBlock
                        Style="{StaticResource BodyStrongTextBlockStyle}"
                        Text="{x:Bind Label}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxLines="2"
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="{x:Bind Description}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <ToggleSwitch
                    Grid.Column="2"
                    MinWidth="0"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind Label}"
                    IsOn="{x:Bind BoolValue, Mode=TwoWay}"
                    OffContent=""
                    OnContent="" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TrophyGridTemplate" x:DataType="vm:TrophyGridBlock">
            <StackPanel Spacing="4">
                <Grid Margin="2,0,0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Style="{StaticResource BlockTitleStyle}" Text="{x:Bind Title}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Progress, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="{x:Bind Description}"
                            Visibility="{x:Bind HasDescription}" />
                    </StackPanel>
                    <ItemsRepeater
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        ItemTemplate="{StaticResource BlockActionTemplate}"
                        ItemsSource="{x:Bind Actions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
                <ItemsControl
                    x:Name="Items"
                    ItemTemplate="{StaticResource TrophyCardTemplate}"
                    ItemsSource="{x:Bind Trophies}"
                    IsTabStop="False">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <views:AdaptiveGridPanel MinItemWidth="330" ColumnSpacing="8" RowSpacing="8" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="CareerEventCardTemplate" x:DataType="vm:CareerEventViewModel">
            <Grid
                Padding="12,10"
                Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                BorderThickness="1"
                ColumnSpacing="12"
                CornerRadius="{StaticResource OverlayCornerRadius}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <!--  Theme colours come from ThemeResources so they follow the window's theme; the medal  -->
                <!--  colour is drawn over them once the event has one.  -->
                <Grid
                    Width="36"
                    Height="36"
                    Background="{ThemeResource ControlFillColorTertiaryBrush}"
                    CornerRadius="18">
                    <Border Background="{x:Bind views:Ui.MedalBrush(MedalIndex), Mode=OneWay}" CornerRadius="18" />
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="{x:Bind KindGlyph}"
                        Visibility="{x:Bind views:Ui.CollapsedIfAny(MedalIndex), Mode=OneWay}" />
                    <FontIcon
                        FontSize="16"
                        Foreground="White"
                        Glyph="{x:Bind KindGlyph}"
                        Visibility="{x:Bind views:Ui.VisibleIfAny(MedalIndex), Mode=OneWay}" />
                </Grid>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Spacing="1">
                    <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="{x:Bind Subtitle}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="NoWrap">
                        <ToolTipService.ToolTip>
                            <ToolTip Content="{x:Bind RoundsToolTip}" />
                        </ToolTipService.ToolTip>
                    </TextBlock>
                </StackPanel>
                <ComboBox
                    Grid.Column="2"
                    Width="148"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind Event.FullName}"
                    DropDownClosed="OnComboDropDownClosed"
                    DropDownOpened="OnComboDropDownOpened"
                    ItemsSource="{x:Bind vm:CareerEventViewModel.MedalOptions}"
                    SelectedIndex="{x:Bind MedalIndex, Mode=OneWay}"
                    SelectionChanged="OnMedalSelectionChanged" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="CareerEventsTemplate" x:DataType="vm:CareerEventsBlock">
            <StackPanel Spacing="4">
                <Grid Margin="2,0,0,6" ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Bottom" Spacing="2">
                        <StackPanel Orientation="Horizontal" Spacing="12">
                            <TextBlock Style="{StaticResource BlockTitleStyle}" Text="{x:Bind Title}" />
                            <TextBlock
                                VerticalAlignment="Bottom"
                                Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Progress, Mode=OneWay}" />
                        </StackPanel>
                        <TextBlock
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="{x:Bind Description}"
                            Visibility="{x:Bind HasDescription}" />
                    </StackPanel>
                    <ItemsRepeater
                        Grid.Column="1"
                        VerticalAlignment="Bottom"
                        ItemTemplate="{StaticResource BlockActionTemplate}"
                        ItemsSource="{x:Bind Actions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
                <ItemsControl
                    x:Name="TierList"
                    IsTabStop="False"
                    ItemsSource="{x:Bind Tiers}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:CareerTierGroup">
                            <StackPanel Margin="0,4,0,10" Spacing="8">
                                <TextBlock
                                    Margin="2,0,0,0"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind Title}" />
                                <ItemsControl
                                    x:Name="Items"
                                    IsTabStop="False"
                                    ItemTemplate="{StaticResource CareerEventCardTemplate}"
                                    ItemsSource="{x:Bind Events}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <views:AdaptiveGridPanel
                                                ColumnSpacing="8"
                                                MinItemWidth="340"
                                                RowSpacing="8" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                </ItemsControl>
                            </StackPanel>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </DataTemplate>

        <!--  Tables.  -->
        <DataTemplate x:Key="TableColumnHeaderTemplate" x:DataType="vm:TableColumn">
            <TextBlock
                Width="{x:Bind Width}"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind Header}"
                TextTrimming="CharacterEllipsis"
                ToolTipService.ToolTip="{x:Bind views:Ui.Tip(Tooltip)}" />
        </DataTemplate>

        <DataTemplate x:Key="TableCellTemplate" x:DataType="vm:TableCell">
            <ContentControl
                Width="{x:Bind Width}"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Center"
                Content="{x:Bind Field}"
                ContentTemplateSelector="{StaticResource CellEditorSelector}"
                IsTabStop="False" />
        </DataTemplate>

        <DataTemplate x:Key="TableRowTemplate" x:DataType="vm:TableRowViewModel">
            <Grid
                MinHeight="48"
                Padding="16,6,16,6"
                Background="{x:Bind views:Ui.HighlightBrush(IsHighlighted), Mode=OneWay}"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,1,0,0">
                <Rectangle
                    Width="3"
                    Height="22"
                    Margin="-12,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                    RadiusX="1.5"
                    RadiusY="1.5"
                    Visibility="{x:Bind IsModified, Mode=OneWay}" />
                <StackPanel Orientation="Horizontal" Spacing="12">
                    <StackPanel
                        Width="{x:Bind Table.TitleColumnWidth, Mode=OneWay}"
                        VerticalAlignment="Center"
                        Spacing="0">
                        <TextBlock
                            Text="{x:Bind Title, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap">
                            <ToolTipService.ToolTip>
                                <ToolTip Content="{x:Bind Title, Mode=OneWay}" />
                            </ToolTipService.ToolTip>
                        </TextBlock>
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Subtitle, Mode=OneWay}"
                            TextTrimming="CharacterEllipsis"
                            TextWrapping="NoWrap"
                            Visibility="{x:Bind HasSubtitle, Mode=OneWay}" />
                    </StackPanel>
                    <ItemsRepeater ItemTemplate="{StaticResource TableCellTemplate}" ItemsSource="{x:Bind Cells}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="12" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                    <Button
                        Padding="8,6"
                        VerticalAlignment="Center"
                        AutomationProperties.Name="Revert"
                        Background="Transparent"
                        BorderThickness="0"
                        Click="OnRevertRowClicked"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Put back the value from the file"
                        Visibility="{x:Bind IsModified, Mode=OneWay}">
                        <FontIcon FontSize="14" Glyph="&#xE777;" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="TableTemplate" x:DataType="vm:TableBlock">
            <StackPanel Spacing="8">
                <StackPanel Margin="2,0,0,0" Spacing="2">
                    <TextBlock Style="{StaticResource BlockTitleStyle}" Text="{x:Bind Title}" />
                    <TextBlock
                        Style="{StaticResource SecondaryCaptionStyle}"
                        Text="{x:Bind Description}"
                        Visibility="{x:Bind HasDescription}" />
                </StackPanel>
                <!--  Margins rather than ColumnSpacing: a collapsed filter box or checkbox leaves no gap.  -->
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBox
                        Width="240"
                        Margin="0,0,12,0"
                        PlaceholderText="Filter rows"
                        Text="{x:Bind Filter, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        Visibility="{x:Bind ShowFilter, Mode=OneWay}" />
                    <CheckBox
                        Grid.Column="1"
                        Margin="0,0,12,0"
                        Content="{x:Bind HideEmptyLabel}"
                        IsChecked="{x:Bind HideEmptyChecked, Mode=TwoWay}"
                        Visibility="{x:Bind CanHideEmpty}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Summary, Mode=OneWay}" />
                    <ItemsRepeater
                        Grid.Column="3"
                        Margin="12,0,0,0"
                        ItemTemplate="{StaticResource BlockActionTemplate}"
                        ItemsSource="{x:Bind Actions}">
                        <ItemsRepeater.Layout>
                            <StackLayout Orientation="Horizontal" Spacing="8" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </Grid>
                <Border Style="{StaticResource CardBorderStyle}">
                    <ScrollViewer
                        HorizontalScrollBarVisibility="Auto"
                        HorizontalScrollMode="Auto"
                        SizeChanged="OnTableViewportSizeChanged"
                        Tag="{x:Bind}"
                        VerticalScrollBarVisibility="Disabled"
                        VerticalScrollMode="Disabled">
                        <StackPanel MinWidth="{x:Bind TableWidth, Mode=OneWay}">
                            <StackPanel
                                Padding="16,10,16,8"
                                Orientation="Horizontal"
                                Spacing="12">
                                <TextBlock
                                    Width="{x:Bind TitleColumnWidth, Mode=OneWay}"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}"
                                    Text="{x:Bind TitleHeader}" />
                                <ItemsRepeater ItemTemplate="{StaticResource TableColumnHeaderTemplate}" ItemsSource="{x:Bind Columns}">
                                    <ItemsRepeater.Layout>
                                        <StackLayout Orientation="Horizontal" Spacing="12" />
                                    </ItemsRepeater.Layout>
                                </ItemsRepeater>
                            </StackPanel>
                            <ItemsRepeater
                                x:Name="Rows"
                                ItemTemplate="{StaticResource TableRowTemplate}"
                                ItemsSource="{x:Bind VisibleRows}" />
                            <StackPanel
                                Margin="16,8"
                                Orientation="Horizontal"
                                Spacing="4"
                                Visibility="{x:Bind HasNoVisibleRows, Mode=OneWay}">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                    Text="{x:Bind EmptyText, Mode=OneWay}" />
                                <HyperlinkButton
                                    Command="{x:Bind EmptyActionCommand}"
                                    Content="{x:Bind EmptyActionText, Mode=OneWay}"
                                    Visibility="{x:Bind HasEmptyAction, Mode=OneWay}" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="JumpTemplate" x:DataType="vm:JumpTarget">
            <Button
                Padding="0"
                AutomationProperties.Name="{x:Bind Title}"
                BorderThickness="0"
                Click="OnJumpClicked"
                CornerRadius="14"
                Tag="{x:Bind}">
                <Grid>
                    <Border
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="14"
                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                    <TextBlock
                        Margin="12,4"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Title}"
                        Visibility="{x:Bind views:Ui.Collapsed(IsActive), Mode=OneWay}" />
                    <TextBlock
                        Margin="12,4"
                        Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Title}"
                        Visibility="{x:Bind IsActive, Mode=OneWay}" />
                </Grid>
            </Button>
        </DataTemplate>

        <views:BlockTemplateSelector
            x:Key="BlockSelector"
            CareerEvents="{StaticResource CareerEventsTemplate}"
            FieldGroup="{StaticResource FieldGroupTemplate}"
            Note="{StaticResource NoteTemplate}"
            Table="{StaticResource TableTemplate}"
            TrophyGrid="{StaticResource TrophyGridTemplate}" />
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Padding="40,8,40,12" Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="{x:Bind ViewModel.Title, Mode=OneWay}" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind ViewModel.Subtitle, Mode=OneWay}"
                TextWrapping="Wrap" />
            <ScrollViewer
                x:Name="JumpScroller"
                Margin="0,10,0,0"
                HorizontalScrollBarVisibility="Hidden"
                HorizontalScrollMode="Auto"
                VerticalScrollBarVisibility="Disabled"
                VerticalScrollMode="Disabled"
                Visibility="Collapsed">
                <ItemsRepeater x:Name="JumpRepeater" ItemTemplate="{StaticResource JumpTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Orientation="Horizontal" Spacing="6" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </ScrollViewer>
        </StackPanel>

        <Rectangle
            x:Name="HeaderDivider"
            Grid.Row="1"
            Height="1"
            VerticalAlignment="Top"
            Fill="{ThemeResource DividerStrokeColorDefaultBrush}"
            Visibility="Collapsed" />

        <ScrollViewer
            x:Name="PageScroller"
            Grid.Row="1"
            VerticalScrollBarVisibility="Auto"
            ViewChanged="OnPageScrolled">
            <ItemsRepeater
                x:Name="BlocksRepeater"
                Margin="40,20,40,48"
                ItemTemplate="{StaticResource BlockSelector}"
                ItemsSource="{x:Bind ViewModel.Blocks, Mode=OneWay}">
                <ItemsRepeater.Layout>
                    <StackLayout Spacing="36" />
                </ItemsRepeater.Layout>
            </ItemsRepeater>
        </ScrollViewer>
    </Grid>
</Page>
