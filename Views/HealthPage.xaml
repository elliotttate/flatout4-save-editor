<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.HealthPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FlatOut4SaveEditor.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="HealthIssueTemplate" x:DataType="vm:HealthIssueViewModel">
            <Grid
                Padding="16,10,12,10"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel Spacing="2">
                    <HyperlinkButton
                        Padding="0"
                        HorizontalAlignment="Left"
                        AutomationProperties.Name="{x:Bind Title}"
                        Click="OnShowClicked"
                        Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Show this value">
                        <StackPanel Spacing="1">
                            <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                Text="{x:Bind Context}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </HyperlinkButton>
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Problem}"
                        TextWrapping="Wrap" />
                </StackPanel>
                <Button
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="{x:Bind RepairText}"
                    Click="OnRepairIssueClicked"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="{x:Bind RepairText}">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon FontSize="14" Glyph="&#xE90F;" />
                        <TextBlock Text="{x:Bind RepairText}" />
                    </StackPanel>
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="HealthGroupTemplate" x:DataType="vm:HealthGroup">
            <StackPanel Spacing="8">
                <Grid Margin="2,0,0,0" ColumnSpacing="10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Center"
                        FontSize="16"
                        Foreground="{ThemeResource SystemFillColorCautionBrush}"
                        Glyph="{x:Bind Glyph}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Style="{StaticResource BlockTitleStyle}"
                        Text="{x:Bind Title}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind CountText}" />
                    <Button
                        Grid.Column="3"
                        Click="OnRepairGroupClicked"
                        Content="{x:Bind RepairLabel}"
                        Tag="{x:Bind}"
                        ToolTipService.ToolTip="Repair every value in this group (one undo step)" />
                </Grid>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <ItemsRepeater ItemTemplate="{StaticResource HealthIssueTemplate}" ItemsSource="{x:Bind Shown}" />
                        <TextBlock
                            Margin="16,10,16,12"
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind MoreText}"
                            Visibility="{x:Bind HasMore}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="NoteTemplate" x:DataType="x:String">
            <Grid Padding="0,2" ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Ellipse
                    Width="5"
                    Height="5"
                    Margin="0,8,0,0"
                    VerticalAlignment="Top"
                    Fill="{ThemeResource TextFillColorTertiaryBrush}" />
                <TextBlock
                    Grid.Column="1"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    Text="{x:Bind}"
                    TextWrapping="Wrap" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="SlotTemplate" x:DataType="vm:KeptSlot">
            <Grid
                Padding="16,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="140" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="{x:Bind Title}" />
                <TextBlock
                    Grid.Column="1"
                    FontFamily="Consolas"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    IsTextSelectionEnabled="True"
                    Text="{x:Bind Value}" />
            </Grid>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,8,40,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Save health" />
                <TextBlock
                    x:Name="SummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RepairAllButton"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="OnRepairAllClicked"
                Style="{StaticResource AccentButtonStyle}"
                ToolTipService.ToolTip="Set every value below to what a new profile has (one undo step)">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE90F;" />
                    <TextBlock Text="Repair all" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1080"
                Margin="40,4,40,48"
                HorizontalAlignment="Stretch"
                Spacing="28">

                <Border
                    x:Name="RecoveryCard"
                    Padding="20,16"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <FontIcon
                            x:Name="RecoveryIcon"
                            VerticalAlignment="Top"
                            FontSize="22"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE9F5;" />
                        <StackPanel Grid.Column="1" Spacing="8">
                            <TextBlock x:Name="RecoveryTitle" Style="{StaticResource BlockTitleStyle}" />
                            <TextBlock x:Name="RecoverySummary" TextWrapping="Wrap" />
                            <ItemsRepeater x:Name="RecoveryNotes" ItemTemplate="{StaticResource NoteTemplate}" />
                            <TextBlock
                                x:Name="RecoveryFootnote"
                                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel
                    x:Name="HealthyState"
                    Margin="0,32,0,0"
                    HorizontalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource SystemFillColorSuccessBrush}"
                        Glyph="&#xE73E;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="No problems found" />
                    <TextBlock
                        MaxWidth="520"
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Every binding, choice, number and marker holds a value the game writes itself."
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>

                <ItemsRepeater x:Name="GroupsRepeater" ItemTemplate="{StaticResource HealthGroupTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="28" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>

                <StackPanel x:Name="KeptSection" Spacing="8">
                    <StackPanel
                        Margin="2,0,0,0"
                        Orientation="Horizontal"
                        Spacing="10">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE72E;" />
                        <TextBlock Style="{StaticResource BlockTitleStyle}" Text="Unknown extension slots" />
                        <TextBlock
                            x:Name="KeptCount"
                            VerticalAlignment="Bottom"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}" />
                    </StackPanel>
                    <TextBlock
                        Margin="2,0,0,0"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Not read by any build yet. Usually leftover memory, but newer builds store new settings here, so every value is written back unchanged."
                        TextWrapping="Wrap" />
                    <Border Style="{StaticResource CardBorderStyle}">
                        <StackPanel>
                            <ItemsRepeater x:Name="KeptRepeater" ItemTemplate="{StaticResource SlotTemplate}" />
                            <TextBlock
                                x:Name="KeptMore"
                                Margin="16,10,16,12"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
