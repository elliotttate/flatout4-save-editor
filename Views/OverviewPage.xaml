<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.OverviewPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:svc="using:FlatOut4SaveEditor.Services"
    xmlns:views="using:FlatOut4SaveEditor.Views"
    xmlns:vm="using:FlatOut4SaveEditor.ViewModels">

    <Page.Resources>
        <Style x:Key="CardButtonStyle" BasedOn="{StaticResource DefaultButtonStyle}" TargetType="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="VerticalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="16,14" />
            <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
            <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
            <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        </Style>

        <DataTemplate x:Key="CandidateTemplate" x:DataType="svc:FlatOut4SaveCandidate">
            <Button
                Click="OnCandidateClicked"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="40"
                        Height="40"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="{x:Bind views:OverviewPage.KindGlyph(Kind)}" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind Details}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Folder}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="RecentTemplate" x:DataType="svc:RecentSave">
            <Button
                Click="OnRecentClicked"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="40"
                        Height="40"
                        Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                        BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="18"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="&#xE81C;" />
                    </Grid>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind FileName}" />
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="{x:Bind OpenedText}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Folder}"
                            TextTrimming="CharacterEllipsis"
                            ToolTipService.ToolTip="{x:Bind Path}" />
                    </StackPanel>
                    <FontIcon
                        Grid.Column="2"
                        FontSize="14"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Glyph="&#xE76C;" />
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="TileTemplate" x:DataType="vm:StatTile">
            <Button
                Click="OnTileClicked"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind PageKey}">
                <StackPanel Spacing="6">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <FontIcon
                            FontSize="14"
                            Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Title}" />
                    </StackPanel>
                    <TextBlock
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="{x:Bind Value, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind Caption, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                    <ProgressBar
                        Margin="0,4,0,0"
                        Maximum="1"
                        Visibility="{x:Bind HasProgress}"
                        Value="{x:Bind Progress, Mode=OneWay}" />
                </StackPanel>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="QuickActionTemplate" x:DataType="vm:QuickAction">
            <Button
                AutomationProperties.Name="{x:Bind Title}"
                Click="OnQuickActionClicked"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="36"
                        Height="36"
                        VerticalAlignment="Top"
                        Background="{ThemeResource AccentFillColorDefaultBrush}"
                        CornerRadius="8">
                        <FontIcon
                            FontSize="16"
                            Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                            Glyph="{x:Bind Glyph}" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="{x:Bind Description}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>

        <DataTemplate x:Key="SectionCardTemplate" x:DataType="vm:PageViewModel">
            <Button
                Click="OnSectionClicked"
                Style="{StaticResource CardButtonStyle}"
                Tag="{x:Bind Key}">
                <Grid ColumnSpacing="14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <FontIcon
                        VerticalAlignment="Top"
                        FontSize="22"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="{x:Bind Glyph}" />
                    <StackPanel Grid.Column="1" Spacing="2">
                        <TextBlock Style="{StaticResource BodyStrongTextBlockStyle}" Text="{x:Bind Title}" />
                        <TextBlock
                            MaxLines="2"
                            Style="{StaticResource SecondaryCaptionStyle}"
                            Text="{x:Bind Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,4,0,0"
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind FieldCountText}" />
                    </StackPanel>
                </Grid>
            </Button>
        </DataTemplate>
    </Page.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <Grid Padding="40,8,40,48">
            <!--  No save open: welcome + detected saves.  -->
            <StackPanel
                x:Name="WelcomePanel"
                MaxWidth="1080"
                HorizontalAlignment="Stretch"
                Spacing="28">
                <Grid
                    Padding="32,28"
                    ColumnSpacing="28"
                    CornerRadius="{StaticResource OverlayCornerRadius}">
                    <Grid.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Offset="0" Color="{ThemeResource SystemAccentColorDark1}" />
                            <GradientStop Offset="1" Color="{ThemeResource SystemAccentColorDark3}" />
                        </LinearGradientBrush>
                    </Grid.Background>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Grid
                        Width="72"
                        Height="72"
                        VerticalAlignment="Top"
                        Background="#33FFFFFF"
                        CornerRadius="16">
                        <FontIcon
                            FontSize="36"
                            Foreground="White"
                            Glyph="&#xE804;" />
                    </Grid>
                    <StackPanel Grid.Column="1" Spacing="10">
                        <TextBlock
                            Foreground="White"
                            Style="{StaticResource TitleTextBlockStyle}"
                            Text="FlatOut 4 Save Editor" />
                        <TextBlock
                            MaxWidth="640"
                            HorizontalAlignment="Left"
                            Foreground="#E6FFFFFF"
                            Text="Edit career medals, garage unlocks, trophies, records, options and bindings in FlatOut 4 and FlatOut VR profiles. Reads every layout from V82 up to the current V95 and the RC-only V96, and recovers cut-off, damaged or newer saves."
                            TextWrapping="Wrap" />
                        <StackPanel
                            Margin="0,8,0,0"
                            Orientation="Horizontal"
                            Spacing="8">
                            <Button Click="OnFindClicked" Style="{StaticResource AccentButtonStyle}">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE721;" />
                                    <TextBlock Text="Find my saves" />
                                </StackPanel>
                            </Button>
                            <Button Click="OnBrowseClicked">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                    <TextBlock Text="Browse for a file..." />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Grid>

                <StackPanel x:Name="RecentPanel" Spacing="8">
                    <Grid>
                        <TextBlock Style="{StaticResource BlockTitleStyle}" Text="Recent" />
                        <HyperlinkButton
                            Padding="6,2"
                            HorizontalAlignment="Right"
                            Click="OnClearRecentClicked"
                            Content="Clear list" />
                    </Grid>
                    <ItemsRepeater x:Name="RecentRepeater" ItemTemplate="{StaticResource RecentTemplate}">
                        <ItemsRepeater.Layout>
                            <StackLayout Spacing="6" />
                        </ItemsRepeater.Layout>
                    </ItemsRepeater>
                </StackPanel>

                <StackPanel x:Name="CandidatesPanel" Spacing="24" />

                <TextBlock
                    x:Name="NoCandidatesText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap"
                    Visibility="Collapsed" />
            </StackPanel>

            <!--  Save open: dashboard.  -->
            <StackPanel
                x:Name="DashboardPanel"
                Spacing="32"
                Visibility="Collapsed">
                <StackPanel Spacing="4">
                    <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Overview" />
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Text="A summary of the open save. Pick a tile or section to edit it." />
                </StackPanel>

                <Border
                    MaxWidth="1080"
                    HorizontalAlignment="Stretch"
                    Padding="20,16"
                    Style="{StaticResource CardBorderStyle}">
                    <Grid ColumnSpacing="20">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Grid
                            Width="48"
                            Height="48"
                            VerticalAlignment="Top"
                            Background="{ThemeResource AccentFillColorDefaultBrush}"
                            CornerRadius="10">
                            <FontIcon
                                x:Name="SourceGlyph"
                                FontSize="22"
                                Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                Glyph="&#xE8A5;" />
                        </Grid>
                        <StackPanel Grid.Column="1" Spacing="4">
                            <TextBlock
                                x:Name="FileNameText"
                                Style="{StaticResource SubtitleTextBlockStyle}" />
                            <TextBlock
                                x:Name="FilePathText"
                                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                Style="{StaticResource CaptionTextBlockStyle}"
                                TextTrimming="CharacterEllipsis" />
                            <ItemsControl
                                x:Name="ChipsRepeater"
                                Margin="0,8,0,0"
                                IsTabStop="False">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <views:WrapPanel Spacing="6" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="x:String">
                                        <Border
                                            Padding="10,3"
                                            Background="{ThemeResource SubtleFillColorSecondaryBrush}"
                                            BorderBrush="{ThemeResource ControlStrokeColorDefaultBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                            <TextBlock Style="{StaticResource CaptionTextBlockStyle}" Text="{x:Bind}" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Top"
                            Spacing="8">
                            <Button
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnRevealClicked"
                                ToolTipService.ToolTip="Show the file in Explorer">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon FontSize="14" Glyph="&#xE838;" />
                                    <TextBlock Text="Show in folder" />
                                </StackPanel>
                            </Button>
                            <Button
                                x:Name="HealthButton"
                                HorizontalAlignment="Stretch"
                                HorizontalContentAlignment="Left"
                                Click="OnHealthClicked"
                                ToolTipService.ToolTip="Open Save health">
                                <StackPanel Orientation="Horizontal" Spacing="8">
                                    <FontIcon
                                        x:Name="HealthGlyph"
                                        FontSize="14"
                                        Glyph="&#xE95E;" />
                                    <TextBlock x:Name="HealthText" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BlockTitleStyle}" Text="At a glance" />
                    <ItemsControl x:Name="TilesRepeater" ItemTemplate="{StaticResource TileTemplate}"
                        IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:AdaptiveGridPanel MinItemWidth="230" ColumnSpacing="8" RowSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <StackPanel Spacing="2">
                        <TextBlock Style="{StaticResource BlockTitleStyle}" Text="Quick actions" />
                        <TextBlock Style="{StaticResource SecondaryCaptionStyle}" Text="Common edits in one click. Each is a single undo step, and nothing is written until you save." />
                    </StackPanel>
                    <ItemsControl
                        x:Name="QuickActionsRepeater"
                        IsTabStop="False"
                        ItemTemplate="{StaticResource QuickActionTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:AdaptiveGridPanel MinItemWidth="300" ColumnSpacing="8" RowSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>

                <StackPanel Spacing="12">
                    <TextBlock Style="{StaticResource BlockTitleStyle}" Text="Sections" />
                    <ItemsControl x:Name="SectionsRepeater" ItemTemplate="{StaticResource SectionCardTemplate}"
                        IsTabStop="False">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <views:AdaptiveGridPanel MinItemWidth="300" ColumnSpacing="8" RowSpacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </StackPanel>
        </Grid>
    </ScrollViewer>
</Page>
