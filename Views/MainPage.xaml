<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FlatOut4SaveEditor.ViewModels"
    Background="Transparent">

    <Page.KeyboardAccelerators>
        <KeyboardAccelerator
            Key="S"
            Invoked="OnSaveAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="O"
            Invoked="OnOpenAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="F"
            Invoked="OnSearchAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="OnNextSectionAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Tab"
            Invoked="OnPreviousSectionAccelerator"
            Modifiers="Control,Shift" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="OnUndoAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Y"
            Invoked="OnRedoAccelerator"
            Modifiers="Control" />
        <KeyboardAccelerator
            Key="Z"
            Invoked="OnRedoAccelerator"
            Modifiers="Control,Shift" />
    </Page.KeyboardAccelerators>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid
            x:Name="AppTitleBar"
            Padding="16,0,150,0"
            ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Grid
                Width="22"
                Height="22"
                VerticalAlignment="Center"
                Background="{ThemeResource AccentFillColorDefaultBrush}"
                CornerRadius="5">
                <FontIcon
                    FontSize="12"
                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                    Glyph="&#xE804;" />
            </Grid>
            <TextBlock
                Grid.Column="1"
                VerticalAlignment="Center"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="FlatOut 4 Save Editor" />
            <TextBlock
                x:Name="TitleFileText"
                Grid.Column="2"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                TextTrimming="CharacterEllipsis" />
        </Grid>

        <NavigationView
            x:Name="Nav"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsSettingsVisible="False"
            IsTitleBarAutoPaddingEnabled="False"
            DisplayModeChanged="OnNavDisplayModeChanged"
            ItemInvoked="OnNavItemInvoked"
            PaneClosing="OnNavPaneClosing"
            PaneOpening="OnNavPaneOpening"
            CompactModeThresholdWidth="0"
            ExpandedModeThresholdWidth="1240"
            OpenPaneLength="264"
            PaneDisplayMode="Auto">
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="SearchBox"
                    IsEnabled="False"
                    PlaceholderText="Search the save (Ctrl+F)"
                    QueryIcon="Find"
                    QuerySubmitted="OnSearchSubmitted"
                    SuggestionChosen="OnSuggestionChosen"
                    TextChanged="OnSearchTextChanged"
                    UpdateTextOnSelect="False">
                    <AutoSuggestBox.ItemTemplate>
                        <DataTemplate x:DataType="vm:SearchResult">
                            <Grid Padding="0,6" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    FontSize="16"
                                    Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                                    Glyph="{x:Bind Glyph}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                        Style="{StaticResource CaptionTextBlockStyle}"
                                        Text="{x:Bind Context}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </AutoSuggestBox.ItemTemplate>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>

            <NavigationView.PaneFooter>
                <!--  One row, so the section list above keeps its room on shorter windows.  -->
                <StackPanel x:Name="BackupFooter" Padding="16,4,16,8">
                    <ToggleSwitch
                        x:Name="BackupToggle"
                        AutomationProperties.Name="Back up before saving"
                        IsOn="True"
                        OffContent="Back up before saving"
                        OnContent="Back up before saving"
                        ToolTipService.ToolTip="Copies the file to Save.bak-&lt;date&gt; before writing" />
                </StackPanel>
            </NavigationView.PaneFooter>

            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Grid
                    x:Name="Toolbar"
                    Padding="40,16,40,8"
                    ColumnSpacing="8"
                    SizeChanged="OnToolbarSizeChanged">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel
                        x:Name="ToolbarStart"
                        Orientation="Horizontal"
                        Spacing="6">
                        <Button Click="OnOpenClicked" ToolTipService.ToolTip="Open a save file (Ctrl+O)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE8E5;" />
                                <TextBlock Text="Open" />
                            </StackPanel>
                        </Button>
                        <Button
                            AutomationProperties.Name="Find saves"
                            Click="OnFindClicked"
                            ToolTipService.ToolTip="Look for saves in Steam Cloud and the usual folders">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE721;" />
                                <TextBlock x:Name="FindSavesLabel" Text="Find saves" />
                            </StackPanel>
                        </Button>
                        <AppBarSeparator />
                        <SplitButton
                            x:Name="UndoButton"
                            Padding="10,5,8,6"
                            AutomationProperties.Name="Undo"
                            Click="OnUndoClicked"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Undo (Ctrl+Z)">
                            <FontIcon
                                Height="20"
                                FontSize="14"
                                Glyph="&#xE7A7;" />
                            <SplitButton.Flyout>
                                <MenuFlyout
                                    x:Name="UndoHistoryFlyout"
                                    Opening="OnUndoHistoryOpening"
                                    Placement="BottomEdgeAlignedLeft" />
                            </SplitButton.Flyout>
                        </SplitButton>
                        <Button
                            x:Name="RedoButton"
                            Padding="10,5,10,6"
                            AutomationProperties.Name="Redo"
                            Click="OnRedoClicked"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Redo (Ctrl+Y)">
                            <FontIcon
                                Height="20"
                                FontSize="14"
                                Glyph="&#xE7A6;" />
                        </Button>
                        <AppBarSeparator />
                        <Button
                            x:Name="UnlockAllButton"
                            Click="OnUnlockAllClicked"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Gold in every career event, every garage item unlocked, challenges maxed">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE785;" />
                                <TextBlock x:Name="UnlockAllLabel" Text="Unlock all" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="RevertButton"
                            AutomationProperties.Name="Revert"
                            Click="OnRevertClicked"
                            IsEnabled="False"
                            ToolTipService.ToolTip="Put every value back to what is in the file">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE777;" />
                                <TextBlock x:Name="RevertLabel" Text="Revert" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                    <StackPanel
                        x:Name="ToolbarEnd"
                        Grid.Column="1"
                        Orientation="Horizontal"
                        Spacing="10">
                        <Button
                            x:Name="ChangesPill"
                            Padding="10,4"
                            VerticalAlignment="Center"
                            Background="{ThemeResource AccentFillColorTertiaryBrush}"
                            BorderThickness="0"
                            Click="OnChangesPillClicked"
                            CornerRadius="12"
                            ToolTipService.ToolTip="Review unsaved changes"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal" Spacing="6">
                                <Ellipse
                                    Width="7"
                                    Height="7"
                                    VerticalAlignment="Center"
                                    Fill="{ThemeResource TextOnAccentFillColorPrimaryBrush}" />
                                <TextBlock
                                    x:Name="ChangesText"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Style="{StaticResource CaptionTextBlockStyle}" />
                                <FontIcon
                                    FontSize="10"
                                    Foreground="{ThemeResource TextOnAccentFillColorPrimaryBrush}"
                                    Glyph="&#xE76C;" />
                            </StackPanel>
                        </Button>
                        <Button
                            x:Name="SaveButton"
                            MinWidth="96"
                            Click="OnSaveClicked"
                            IsEnabled="False"
                            Style="{StaticResource AccentButtonStyle}"
                            ToolTipService.ToolTip="Write the save (Ctrl+S)">
                            <StackPanel Orientation="Horizontal" Spacing="8">
                                <FontIcon FontSize="14" Glyph="&#xE74E;" />
                                <TextBlock Text="Save" />
                            </StackPanel>
                        </Button>
                        <DropDownButton
                            x:Name="MoreButton"
                            AutomationProperties.Name="More"
                            ToolTipService.ToolTip="More actions">
                            <FontIcon FontSize="14" Glyph="&#xE712;" />
                            <DropDownButton.Flyout>
                                <MenuFlyout Opening="OnMoreOpening" Placement="BottomEdgeAlignedRight">
                                    <MenuFlyoutItem
                                        x:Name="SaveAsItem"
                                        Click="OnSaveAsClicked"
                                        IsEnabled="False"
                                        Text="Save a copy as...">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE792;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="ReloadItem"
                                        Click="OnReloadClicked"
                                        IsEnabled="False"
                                        Text="Reload from disk">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE72C;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem
                                        x:Name="RevealItem"
                                        Click="OnRevealClicked"
                                        IsEnabled="False"
                                        Text="Show in folder">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE838;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutSeparator />
                                    <ToggleMenuFlyoutItem
                                        x:Name="BackupMenuItem"
                                        Click="OnBackupMenuClicked"
                                        Text="Back up before saving" />
                                    <MenuFlyoutItem Click="OnShortcutsClicked" Text="Keyboard shortcuts">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE765;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                    <MenuFlyoutItem Click="OnAboutClicked" Text="About">
                                        <MenuFlyoutItem.Icon>
                                            <FontIcon Glyph="&#xE946;" />
                                        </MenuFlyoutItem.Icon>
                                    </MenuFlyoutItem>
                                </MenuFlyout>
                            </DropDownButton.Flyout>
                        </DropDownButton>
                    </StackPanel>
                </Grid>

                <StackPanel
                    Grid.Row="1"
                    Padding="40,0,40,0"
                    Spacing="8">
                    <InfoBar
                        x:Name="WarningBar"
                        IsClosable="True"
                        Severity="Warning" />
                    <InfoBar
                        x:Name="StatusBar"
                        IsClosable="True" />
                </StackPanel>

                <Frame x:Name="ContentFrame" Grid.Row="2" />
            </Grid>
        </NavigationView>
    </Grid>
</Page>
