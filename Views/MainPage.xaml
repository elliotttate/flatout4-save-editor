<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid Padding="16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid ColumnSpacing="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Button
                x:Name="OpenButton"
                Click="OnOpenClicked"
                Content="Open Save" />
            <Button
                x:Name="DetectButton"
                Grid.Column="1"
                Click="OnDetectClicked"
                Content="Find Save" />
            <Button
                x:Name="SaveButton"
                Grid.Column="2"
                Click="OnSaveClicked"
                Content="Save"
                IsEnabled="False" />
            <Button
                x:Name="UnlockAllButton"
                Grid.Column="3"
                Click="OnUnlockAllClicked"
                Content="Unlock All"
                IsEnabled="False" />
            <CheckBox
                x:Name="BackupCheckBox"
                Grid.Column="4"
                HorizontalAlignment="Right"
                Content="Create backup on save"
                IsChecked="True"
                VerticalAlignment="Center" />
        </Grid>

        <StackPanel Grid.Row="1" Spacing="4">
            <TextBlock
                x:Name="FilePathText"
                FontWeight="SemiBold"
                Text="No save loaded" />
            <TextBlock
                x:Name="SummaryText"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Open a FlatOut 4 Save file from Steam userdata or browse to a copy." />
        </StackPanel>

        <InfoBar
            x:Name="WarningBar"
            Grid.Row="2"
            IsOpen="False"
            IsClosable="True"
            Severity="Warning" />

        <Grid Grid.Row="3" RowSpacing="8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Grid ColumnSpacing="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="260" />
                    <ColumnDefinition Width="220" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <TextBox
                    x:Name="SearchBox"
                    PlaceholderText="Filter values"
                    TextChanged="OnFilterChanged" />
                <ComboBox
                    x:Name="SectionBox"
                    Grid.Column="1"
                    HorizontalAlignment="Stretch"
                    SelectionChanged="OnFilterChanged" />
                <TextBlock
                    x:Name="FieldCountText"
                    Grid.Column="2"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextAlignment="Right"
                    VerticalAlignment="Center" />
            </Grid>

            <ListView
                x:Name="FieldsList"
                Grid.Row="1"
                ItemsSource="{Binding VisibleFields}"
                SelectionMode="None">
                <ListView.Header>
                    <Grid
                        Padding="10,0,10,6"
                        ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="4*" />
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock FontWeight="SemiBold" Text="Section" />
                        <TextBlock Grid.Column="1" FontWeight="SemiBold" Text="Name" />
                        <TextBlock Grid.Column="2" FontWeight="SemiBold" Text="Value" />
                        <TextBlock Grid.Column="3" FontWeight="SemiBold" Text="Meaning / error" />
                    </Grid>
                </ListView.Header>
                <ListView.ItemTemplate>
                    <DataTemplate>
                        <Grid
                            Padding="10,5"
                            ColumnSpacing="12"
                            MinHeight="38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="120" />
                                <ColumnDefinition Width="4*" />
                                <ColumnDefinition Width="180" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                Text="{Binding Section}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBlock
                                Grid.Column="1"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis"
                                VerticalAlignment="Center" />
                            <TextBox
                                Grid.Column="2"
                                FontFamily="Consolas"
                                IsEnabled="{Binding CanEdit}"
                                MinWidth="140"
                                Text="{Binding DraftValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                <TextBlock
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{Binding LabelValue}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    Foreground="{ThemeResource SystemFillColorCriticalBrush}"
                                    Text="{Binding Error}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>
        </Grid>

        <TextBlock
            x:Name="StatusText"
            Grid.Row="4"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            Text="Ready" />
    </Grid>
</Page>
