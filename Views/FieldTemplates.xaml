<?xml version="1.0" encoding="UTF-8" ?>
<ResourceDictionary
    x:Class="FlatOut4SaveEditor.Views.FieldTemplates"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:FlatOut4SaveEditor.Models"
    xmlns:views="using:FlatOut4SaveEditor.Views">

    <FontFamily x:Key="ValueFontFamily">Cascadia Mono, Consolas</FontFamily>

    <!--  Settings-card editors: label on the left, these on the right.  -->

    <DataTemplate x:Key="CardToggleTemplate" x:DataType="m:SaveFieldViewModel">
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind OnOffText, Mode=OneWay}" />
            <ToggleSwitch
AutomationProperties.Name="{x:Bind Label}"
                            MinWidth="0"
                Margin="0,0,-12,0"
                VerticalAlignment="Center"
                IsOn="{x:Bind BoolValue, Mode=TwoWay}"
                OffContent=""
                OnContent="" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardChoiceTemplate" x:DataType="m:SaveFieldViewModel">
        <ComboBox
AutomationProperties.Name="{x:Bind Label}"
                        MinWidth="220"
            HorizontalAlignment="Right"
            DisplayMemberPath="Label"
            ItemsSource="{x:Bind Options, Mode=OneWay}"
            DropDownClosed="OnComboDropDownClosed"
            DropDownOpened="OnComboDropDownOpened"
            SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
            SelectionChanged="OnChoiceSelectionChanged" />
    </DataTemplate>

    <DataTemplate x:Key="CardNumberTemplate" x:DataType="m:SaveFieldViewModel">
        <StackPanel HorizontalAlignment="Right" Spacing="2">
            <NumberBox
AutomationProperties.Name="{x:Bind Label}"
                            MinWidth="180"
                LargeChange="{x:Bind LargeChange}"
                DataContextChanged="OnNumberBoxDataContextChanged"
                SmallChange="{x:Bind SmallChange}"
                SpinButtonPlacementMode="Compact"
                ValidationMode="InvalidInputOverwritten"
                Value="{x:Bind NumberValue, Mode=TwoWay}" />
            <TextBlock
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ValueLabel, Mode=OneWay}"
                Visibility="{x:Bind HasValueLabel, Mode=OneWay}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardRangeTemplate" x:DataType="m:SaveFieldViewModel">
        <StackPanel
            HorizontalAlignment="Right"
            Orientation="Horizontal"
            Spacing="12">
            <Slider
AutomationProperties.Name="{x:Bind Label}"
                            Width="200"
                VerticalAlignment="Center"
                IsThumbToolTipEnabled="True"
                LargeChange="{x:Bind LargeChange}"
                Maximum="{x:Bind Maximum}"
                Minimum="{x:Bind Minimum}"
                SmallChange="{x:Bind SmallChange}"
                StepFrequency="{x:Bind SmallChange}"
                ValueChanged="OnSliderValueChanged"
                Value="{x:Bind NumberValue, Mode=OneWay}" />
            <NumberBox
AutomationProperties.Name="{x:Bind Label}"
                            Width="92"
                VerticalAlignment="Center"
                DataContextChanged="OnNumberBoxDataContextChanged"
                SpinButtonPlacementMode="Hidden"
                ValidationMode="InvalidInputOverwritten"
                Value="{x:Bind NumberValue, Mode=TwoWay}" />
            <TextBlock
                Width="16"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="{x:Bind Unit}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="CardTextTemplate" x:DataType="m:SaveFieldViewModel">
        <StackPanel HorizontalAlignment="Right" Spacing="2">
            <TextBox
AutomationProperties.Name="{x:Bind Label}"
                            MinWidth="220"
                FontFamily="{StaticResource ValueFontFamily}"
                IsSpellCheckEnabled="False"
                Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
            <TextBlock
                MaxWidth="320"
                HorizontalAlignment="Right"
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}"
                Text="{x:Bind ValueLabel, Mode=OneWay}"
                TextTrimming="CharacterEllipsis"
                Visibility="{x:Bind HasValueLabel, Mode=OneWay}" />
        </StackPanel>
    </DataTemplate>

    <DataTemplate x:Key="ReadOnlyTemplate" x:DataType="m:SaveFieldViewModel">
        <TextBlock
            HorizontalAlignment="Right"
            VerticalAlignment="Center"
            FontFamily="{StaticResource ValueFontFamily}"
            Foreground="{ThemeResource TextFillColorSecondaryBrush}"
            IsTextSelectionEnabled="True"
            Text="{x:Bind DisplayValue, Mode=OneWay}" />
    </DataTemplate>

    <DataTemplate x:Key="EmptyCellTemplate">
        <Grid />
    </DataTemplate>

    <views:FieldEditorSelector
        x:Key="CardEditorSelector"
        Choice="{StaticResource CardChoiceTemplate}"
        Empty="{StaticResource EmptyCellTemplate}"
        Number="{StaticResource CardNumberTemplate}"
        Range="{StaticResource CardRangeTemplate}"
        ReadOnly="{StaticResource ReadOnlyTemplate}"
        Text="{StaticResource CardTextTemplate}"
        Toggle="{StaticResource CardToggleTemplate}" />

    <!--
        Compact editors for table cells. Each cell keeps one ToolTip and binds only its Content:
        binding ToolTipService.ToolTip itself re-registers the tooltip whenever the value refreshes,
        and doing that for hundreds of cells at once (Revert) intermittently fails with E_FAIL.
    -->

    <DataTemplate x:Key="CellToggleTemplate" x:DataType="m:SaveFieldViewModel">
        <CheckBox
            MinWidth="0"
            Padding="0"
            HorizontalAlignment="Left"
            AutomationProperties.Name="{x:Bind Label}"
            IsChecked="{x:Bind CheckedValue, Mode=TwoWay}">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind CellToolTip, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </CheckBox>
    </DataTemplate>

    <DataTemplate x:Key="CellChoiceTemplate" x:DataType="m:SaveFieldViewModel">
        <ComboBox
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{x:Bind Label}"
            DisplayMemberPath="Label"
            DropDownClosed="OnComboDropDownClosed"
            DropDownOpened="OnComboDropDownOpened"
            ItemsSource="{x:Bind Options, Mode=OneWay}"
            SelectedIndex="{x:Bind SelectedIndex, Mode=OneWay}"
            SelectionChanged="OnChoiceSelectionChanged">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind CellToolTip, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </ComboBox>
    </DataTemplate>

    <DataTemplate x:Key="CellNumberTemplate" x:DataType="m:SaveFieldViewModel">
        <NumberBox
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{x:Bind Label}"
            DataContextChanged="OnNumberBoxDataContextChanged"
            SpinButtonPlacementMode="Hidden"
            ValidationMode="InvalidInputOverwritten"
            Value="{x:Bind NumberValue, Mode=TwoWay}">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind CellToolTip, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </NumberBox>
    </DataTemplate>

    <DataTemplate x:Key="CellTextTemplate" x:DataType="m:SaveFieldViewModel">
        <TextBox
            HorizontalAlignment="Stretch"
            AutomationProperties.Name="{x:Bind Label}"
            FontFamily="{StaticResource ValueFontFamily}"
            IsSpellCheckEnabled="False"
            Text="{x:Bind TextValue, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}">
            <ToolTipService.ToolTip>
                <ToolTip Content="{x:Bind CellToolTip, Mode=OneWay}" />
            </ToolTipService.ToolTip>
        </TextBox>
    </DataTemplate>

    <views:FieldEditorSelector
        x:Key="CellEditorSelector"
        Choice="{StaticResource CellChoiceTemplate}"
        Empty="{StaticResource EmptyCellTemplate}"
        Number="{StaticResource CellNumberTemplate}"
        Range="{StaticResource CellNumberTemplate}"
        ReadOnly="{StaticResource ReadOnlyTemplate}"
        Text="{StaticResource CellTextTemplate}"
        Toggle="{StaticResource CellToggleTemplate}" />

    <!--  Shared look for setting cards and table frames.  -->

    <Style x:Key="CardBorderStyle" TargetType="Border">
        <Setter Property="Background" Value="{ThemeResource CardBackgroundFillColorDefaultBrush}" />
        <Setter Property="BorderBrush" Value="{ThemeResource CardStrokeColorDefaultBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource OverlayCornerRadius}" />
    </Style>

    <Style x:Key="BlockTitleStyle" BasedOn="{StaticResource BodyStrongTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="FontSize" Value="16" />
    </Style>

    <Style x:Key="SecondaryCaptionStyle" BasedOn="{StaticResource CaptionTextBlockStyle}" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{ThemeResource TextFillColorSecondaryBrush}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>
</ResourceDictionary>
