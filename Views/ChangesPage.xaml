<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.ChangesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:vm="using:FlatOut4SaveEditor.ViewModels">

    <Page.Resources>
        <DataTemplate x:Key="ChangeEntryTemplate" x:DataType="vm:ChangeEntry">
            <Grid
                Padding="16,8,12,8"
                BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                BorderThickness="0,0,0,1"
                ColumnSpacing="16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <HyperlinkButton
                    Padding="0"
                    HorizontalAlignment="Left"
                    AutomationProperties.Name="{x:Bind Title}"
                    Click="OnEntryClicked"
                    Foreground="{ThemeResource TextFillColorPrimaryBrush}"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="Show this value">
                    <StackPanel Spacing="1">
                        <TextBlock Text="{x:Bind Title}" TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                            Style="{StaticResource CaptionTextBlockStyle}"
                            Text="{x:Bind Context}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </HyperlinkButton>
                <StackPanel
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Orientation="Horizontal"
                    Spacing="10">
                    <TextBlock
                        MaxWidth="220"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="{x:Bind Field.OldValueText}"
                        TextDecorations="Strikethrough"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="On disk" />
                    <FontIcon
                        FontSize="12"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE72A;" />
                    <TextBlock
                        MaxWidth="220"
                        FontWeight="SemiBold"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Text="{x:Bind Field.NewValueText, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis"
                        ToolTipService.ToolTip="After saving" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Padding="8,6"
                    VerticalAlignment="Center"
                    AutomationProperties.Name="Revert this change"
                    Background="Transparent"
                    BorderThickness="0"
                    Click="OnRevertEntryClicked"
                    Tag="{x:Bind}"
                    ToolTipService.ToolTip="Revert this change">
                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ChangeGroupTemplate" x:DataType="vm:ChangeGroup">
            <StackPanel Spacing="8">
                <StackPanel
                    Margin="2,0,0,0"
                    Orientation="Horizontal"
                    Spacing="10">
                    <FontIcon
                        FontSize="16"
                        Foreground="{ThemeResource AccentTextFillColorPrimaryBrush}"
                        Glyph="{x:Bind Glyph}" />
                    <TextBlock Style="{StaticResource BlockTitleStyle}" Text="{x:Bind Title}" />
                    <TextBlock
                        VerticalAlignment="Bottom"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Style="{StaticResource CaptionTextBlockStyle}"
                        Text="{x:Bind CountText}" />
                </StackPanel>
                <Border Style="{StaticResource CardBorderStyle}">
                    <StackPanel>
                        <ItemsRepeater ItemTemplate="{StaticResource ChangeEntryTemplate}" ItemsSource="{x:Bind VisibleEntries, Mode=OneWay}" />
                        <HyperlinkButton
                            Margin="8,6,8,8"
                            Click="OnToggleGroupClicked"
                            Content="{x:Bind ToggleText, Mode=OneWay}"
                            Tag="{x:Bind}"
                            Visibility="{x:Bind HasMore}" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </DataTemplate>
    </Page.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Padding="40,8,40,16" ColumnSpacing="16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Spacing="4">
                <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Review changes" />
                <TextBlock
                    x:Name="SummaryText"
                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                    TextWrapping="Wrap" />
            </StackPanel>
            <Button
                x:Name="RevertAllButton"
                Grid.Column="1"
                VerticalAlignment="Bottom"
                Click="OnRevertAllClicked">
                <StackPanel Orientation="Horizontal" Spacing="8">
                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                    <TextBlock Text="Revert all" />
                </StackPanel>
            </Button>
        </Grid>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel
                MaxWidth="1080"
                Margin="40,4,40,48"
                HorizontalAlignment="Stretch"
                Spacing="28">
                <InfoBar
                    x:Name="ConversionNote"
                    IsClosable="False"
                    Severity="Informational"
                    Title="Layout conversion" />
                <StackPanel
                    x:Name="EmptyState"
                    Margin="0,48,0,0"
                    HorizontalAlignment="Center"
                    Spacing="10">
                    <FontIcon
                        FontSize="40"
                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                        Glyph="&#xE73E;" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Style="{StaticResource SubtitleTextBlockStyle}"
                        Text="No unsaved changes" />
                    <TextBlock
                        HorizontalAlignment="Center"
                        Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                        Text="Edits you make anywhere in the editor are listed here until you save." />
                </StackPanel>
                <ItemsRepeater x:Name="GroupsRepeater" ItemTemplate="{StaticResource ChangeGroupTemplate}">
                    <ItemsRepeater.Layout>
                        <StackLayout Spacing="28" />
                    </ItemsRepeater.Layout>
                </ItemsRepeater>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
