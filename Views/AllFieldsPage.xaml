<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="FlatOut4SaveEditor.Views.AllFieldsPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:m="using:FlatOut4SaveEditor.Models">

    <Grid Padding="40,8,40,24" RowSpacing="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Spacing="4">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="All fields" />
            <TextBlock
                Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                Text="Every value in the save in file order, with its raw C++ name, byte offset and type. Edits here are the same edits the other pages make."
                TextWrapping="Wrap" />
        </StackPanel>

        <Grid Grid.Row="1" ColumnSpacing="12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="320" />
                <ColumnDefinition Width="200" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <TextBox
                x:Name="FilterBox"
                PlaceholderText="Filter by name, raw name, offset or value"
                TextChanged="OnFilterChanged" />
            <ComboBox
                x:Name="SectionBox"
                Grid.Column="1"
                HorizontalAlignment="Stretch"
                SelectionChanged="OnFilterChanged" />
            <CheckBox
                x:Name="ModifiedOnlyBox"
                Grid.Column="2"
                Checked="OnFilterChanged"
                Content="Changed only"
                Unchecked="OnFilterChanged" />
            <TextBlock
                x:Name="CountText"
                Grid.Column="3"
                HorizontalAlignment="Right"
                VerticalAlignment="Center"
                Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                Style="{StaticResource CaptionTextBlockStyle}" />
        </Grid>

        <Border Grid.Row="2" Style="{StaticResource CardBorderStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid
                    Padding="28,10,28,8"
                    BorderBrush="{ThemeResource DividerStrokeColorDefaultBrush}"
                    BorderThickness="0,0,0,1"
                    ColumnSpacing="12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="96" />
                        <ColumnDefinition Width="80" />
                        <ColumnDefinition Width="72" />
                        <ColumnDefinition Width="230" />
                        <ColumnDefinition Width="36" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Name" />
                    <TextBlock Grid.Column="1" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Section" />
                    <TextBlock Grid.Column="2" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Offset" />
                    <TextBlock Grid.Column="3" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Type" />
                    <TextBlock Grid.Column="4" Foreground="{ThemeResource TextFillColorSecondaryBrush}" Style="{StaticResource CaptionTextBlockStyle}" Text="Value" />
                </Grid>
                <ListView
                    x:Name="FieldsList"
                    Grid.Row="1"
                    Padding="0,4"
                    SelectionMode="None">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="m:SaveFieldViewModel">
                            <Grid MinHeight="48" Padding="0,4" ColumnSpacing="12">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="96" />
                                    <ColumnDefinition Width="80" />
                                    <ColumnDefinition Width="72" />
                                    <ColumnDefinition Width="230" />
                                    <ColumnDefinition Width="36" />
                                </Grid.ColumnDefinitions>
                                <Rectangle
                                    Width="3"
                                    Height="22"
                                    Margin="-12,0,0,0"
                                    HorizontalAlignment="Left"
                                    Fill="{ThemeResource AccentFillColorDefaultBrush}"
                                    RadiusX="1.5"
                                    RadiusY="1.5"
                                    Visibility="{x:Bind IsModified, Mode=OneWay}" />
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock Text="{x:Bind FullName}" TextTrimming="CharacterEllipsis" ToolTipService.ToolTip="{x:Bind ToolTipText}" />
                                    <TextBlock
                                        FontFamily="{StaticResource ValueFontFamily}"
                                        FontSize="11"
                                        Foreground="{ThemeResource TextFillColorTertiaryBrush}"
                                        IsTextSelectionEnabled="True"
                                        Text="{x:Bind RawName}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Section}" />
                                <TextBlock
                                    Grid.Column="2"
                                    VerticalAlignment="Center"
                                    FontFamily="{StaticResource ValueFontFamily}"
                                    FontSize="12"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Offset}" />
                                <TextBlock
                                    Grid.Column="3"
                                    VerticalAlignment="Center"
                                    Foreground="{ThemeResource TextFillColorSecondaryBrush}"
                                    Text="{x:Bind Type}" />
                                <ContentControl
                                    Grid.Column="4"
                                    HorizontalContentAlignment="Stretch"
                                    VerticalAlignment="Center"
                                    Content="{x:Bind}"
                                    ContentTemplateSelector="{StaticResource CellEditorSelector}"
                                    IsTabStop="False" />
                                <Button
                                    Grid.Column="5"
                                    Padding="6"
                                    AutomationProperties.Name="Revert"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    Click="OnRevertFieldClicked"
                                    Tag="{x:Bind}"
                                    ToolTipService.ToolTip="Put back the value from the file"
                                    Visibility="{x:Bind IsModified, Mode=OneWay}">
                                    <FontIcon FontSize="14" Glyph="&#xE777;" />
                                </Button>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </Grid>
        </Border>
    </Grid>
</Page>
